jerryql> CREATE TABLE sales (id INT PRIMARY KEY, city TEXT, rep TEXT, amount INT);
CREATE TABLE

jerryql> INSERT INTO sales VALUES (1, 'Tokyo', 'Ada', 100), (2, 'Tokyo', 'Ken', 250), (3, 'Paris', 'Ada', 75),
  (4, 'Lima', 'Ken', 300), (5, 'Paris', 'Ada', 25), (6, 'Lima', 'Grace', 300);
INSERT 6

jerryql> SELECT COUNT(*), COUNT(amount), SUM(amount), MIN(amount), MAX(amount), AVG(amount) FROM sales;
+----------+---------------+-------------+-------------+-------------+-------------+
| COUNT(*) | COUNT(amount) | SUM(amount) | MIN(amount) | MAX(amount) | AVG(amount) |
+----------+---------------+-------------+-------------+-------------+-------------+
|        6 |             6 |        1050 |          25 |         300 |         175 |
+----------+---------------+-------------+-------------+-------------+-------------+
(1 row)

jerryql> SELECT MIN(city), MAX(rep) FROM sales;
+-----------+----------+
| MIN(city) | MAX(rep) |
+-----------+----------+
| Lima      | Ken      |
+-----------+----------+
(1 row)

jerryql> SELECT city, COUNT(*) AS n, SUM(amount) AS total FROM sales GROUP BY city ORDER BY total DESC, city;
+-------+---+-------+
| city  | n | total |
+-------+---+-------+
| Lima  | 2 |   600 |
| Tokyo | 2 |   350 |
| Paris | 2 |   100 |
+-------+---+-------+
(3 rows)

jerryql> SELECT rep, city, SUM(amount) FROM sales GROUP BY rep, city;
+-------+-------+-------------+
| rep   | city  | SUM(amount) |
+-------+-------+-------------+
| Ada   | Paris |         100 |
| Ada   | Tokyo |         100 |
| Grace | Lima  |         300 |
| Ken   | Lima  |         300 |
| Ken   | Tokyo |         250 |
+-------+-------+-------------+
(5 rows)

jerryql> SELECT city, SUM(amount) FROM sales GROUP BY city HAVING SUM(amount) > 200 AND COUNT(*) > 1;
+-------+-------------+
| city  | SUM(amount) |
+-------+-------------+
| Lima  |         600 |
| Tokyo |         350 |
+-------+-------------+
(2 rows)

jerryql> SELECT city, MAX(amount) - MIN(amount) AS spread FROM sales GROUP BY city ORDER BY spread DESC LIMIT 2;
+-------+--------+
| city  | spread |
+-------+--------+
| Tokyo |    150 |
| Paris |     50 |
+-------+--------+
(2 rows)

jerryql> SELECT city, COUNT(*) FROM sales GROUP BY city ORDER BY COUNT(*) DESC, city LIMIT 1 OFFSET 1;
+-------+----------+
| city  | COUNT(*) |
+-------+----------+
| Paris |        2 |
+-------+----------+
(1 row)

jerryql> SELECT amount / 100 AS bucket, COUNT(*) FROM sales GROUP BY amount / 100;
+--------+----------+
| bucket | COUNT(*) |
+--------+----------+
|      0 |        2 |
|      1 |        1 |
|      2 |        1 |
|      3 |        2 |
+--------+----------+
(4 rows)

jerryql> SELECT COUNT(*) FROM sales WHERE amount > 1000;
+----------+
| COUNT(*) |
+----------+
|        0 |
+----------+
(1 row)

jerryql> SELECT SUM(amount) FROM sales WHERE id > 100;
+-------------+
| SUM(amount) |
+-------------+
|           0 |
+-------------+
(1 row)

jerryql> SELECT id, amount * 2 AS doubled FROM sales ORDER BY doubled DESC, id LIMIT 3;
+----+---------+
| id | doubled |
+----+---------+
|  4 |     600 |
|  6 |     600 |
|  2 |     500 |
+----+---------+
(3 rows)

jerryql> EXPLAIN SELECT city, SUM(amount) FROM sales WHERE id > 1 GROUP BY city HAVING COUNT(*) > 1 ORDER BY city;
+--------------------------------------------------------+
| QUERY PLAN                                             |
+--------------------------------------------------------+
| PROJECT city, SUM(amount)                              |
|   -> SORT BY city                                      |
|     -> FILTER COUNT(*) > 1                             |
|       -> AGGREGATE SUM(amount), COUNT(*) GROUP BY city |
|         -> FILTER id > 1                               |
|           -> PK RANGE SCAN sales (2 <= id)             |
+--------------------------------------------------------+
(6 rows)

jerryql> SELECT city, amount FROM sales GROUP BY city;
Error: column amount must appear in GROUP BY or inside an aggregate

jerryql> SELECT * FROM sales GROUP BY city;
Error: SELECT * can't be combined with GROUP BY or aggregates

jerryql> SELECT city FROM sales WHERE SUM(amount) > 1;
Error: aggregate SUM(amount) is only allowed in SELECT, HAVING and ORDER BY

jerryql> SELECT MAX(amount) FROM sales WHERE id > 99;
Error: MAX(amount) of no rows (JerryQL has no NULL yet)

jerryql> SELECT SUM(city) FROM sales;
Error: SUM(city) needs INT values

jerryql> SELECT FOO(amount) FROM sales;
Error: syntax error at position 1464: expected COUNT, SUM, MIN, MAX or AVG (no other functions are supported) but found 'FOO'

jerryql> SELECT SUM(SUM(amount)) FROM sales;
Error: aggregates can't be nested: SUM(SUM(amount))

jerryql> UPDATE sales SET amount = COUNT(*);
Error: aggregate COUNT(*) is only allowed in SELECT, HAVING and ORDER BY

