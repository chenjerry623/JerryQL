jerryql> CREATE TABLE employees (id INT PRIMARY KEY, name TEXT, dept TEXT, salary INT);
CREATE TABLE

jerryql> INSERT INTO employees VALUES
  (1, 'Ada', 'Engineering', 185000),
  (2, 'Grace', 'Engineering', 172000),
  (3, 'Linus', 'Infra', 158000),
  (4, 'Barbara', 'Research', 191000),
  (5, 'Ken', 'Infra', 149000);
INSERT 5

jerryql> SELECT * FROM employees;
+----+---------+-------------+--------+
| id | name    | dept        | salary |
+----+---------+-------------+--------+
|  1 | Ada     | Engineering | 185000 |
|  2 | Grace   | Engineering | 172000 |
|  3 | Linus   | Infra       | 158000 |
|  4 | Barbara | Research    | 191000 |
|  5 | Ken     | Infra       | 149000 |
+----+---------+-------------+--------+
(5 rows)

jerryql> SELECT name, salary / 12 AS monthly FROM employees
WHERE dept = 'Engineering' OR salary > 190000
ORDER BY salary DESC;
+---------+---------+
| name    | monthly |
+---------+---------+
| Barbara |   15916 |
| Ada     |   15416 |
| Grace   |   14333 |
+---------+---------+
(3 rows)

jerryql> SELECT name FROM employees ORDER BY name LIMIT 3;
+---------+
| name    |
+---------+
| Ada     |
| Barbara |
| Grace   |
+---------+
(3 rows)

jerryql> EXPLAIN SELECT name FROM employees WHERE id = 3;
+-------------------------------------+
| QUERY PLAN                          |
+-------------------------------------+
| PROJECT name                        |
|   -> FILTER id = 3                  |
|     -> PK LOOKUP employees (id = 3) |
+-------------------------------------+
(3 rows)

jerryql> EXPLAIN SELECT name FROM employees WHERE id >= 2 AND id < 5;
+-----------------------------------------------+
| QUERY PLAN                                    |
+-----------------------------------------------+
| PROJECT name                                  |
|   -> FILTER (id >= 2) AND (id < 5)            |
|     -> PK RANGE SCAN employees (2 <= id <= 4) |
+-----------------------------------------------+
(3 rows)

jerryql> EXPLAIN SELECT name FROM employees WHERE dept = 'Infra' ORDER BY salary DESC LIMIT 1;
+--------------------------------+
| QUERY PLAN                     |
+--------------------------------+
| PROJECT name                   |
|   -> LIMIT 1                   |
|     -> SORT BY salary DESC     |
|       -> FILTER dept = 'Infra' |
|         -> SEQ SCAN employees  |
+--------------------------------+
(5 rows)

jerryql> UPDATE employees SET salary = salary + 10000 WHERE dept = 'Infra';
UPDATE 2

jerryql> DELETE FROM employees WHERE id = 2;
DELETE 1

jerryql> SELECT id, name, salary FROM employees WHERE id >= 2 AND id <= 5;
+----+---------+--------+
| id | name    | salary |
+----+---------+--------+
|  3 | Linus   | 168000 |
|  4 | Barbara | 191000 |
|  5 | Ken     | 159000 |
+----+---------+--------+
(3 rows)

jerryql> INSERT INTO employees VALUES (1, 'Duplicate', 'X', 0);
Error: duplicate primary key: employees.id = 1

jerryql> SELECT name FROM employees WHERE salary = 'lots';
Error: cannot compare INT with TEXT

jerryql> SELEC * FROM employees;
Error: syntax error at position 1203: expected a statement (CREATE, DROP, INSERT, SELECT, EXPLAIN, UPDATE, DELETE, BEGIN, COMMIT, ROLLBACK) but found 'SELEC'

